{
  "name": "muduck",
  "version": "1.0.0",
  "description": "The AI Document Reader & Editor for macOS and Windows",
  "scripts": {
    "dev": "vite",
    "build:renderer": "tsc && vite build",
    "build:quicklook": "vite build -c vite.quicklook.config.ts && cp node_modules/mermaid/dist/mermaid.min.js dist/quicklook/",
    "build": "npm run build:renderer"
  },
  "keywords": [
    "markdown",
    "reader",
    "editor",
    "ai-reports",
    "macos"
  ],
  "author": "Emin Yusifov",
  "license": "MIT",
  "dependencies": {
    "@tauri-apps/api": "~2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-fs": "^2.5.2",
    "@tauri-apps/plugin-opener": "~2.5.0",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.15",
    "highlight.js": "^11.9.0",
    "katex": "^0.16.10",
    "lucide-react": "^0.395.0",
    "marked": "^12.0.2",
    "mermaid": "^10.9.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.3.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.5",
    "@types/katex": "^0.16.7",
    "@types/node": "^20.14.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.4.5",
    "vite": "^5.2.13"
  }
}
