#!/usr/bin/env bash
# Muduck CLI launcher for macOS: `muduck [file.md]`

APP="/Applications/Muduck.app"
if [ ! -d "$APP" ]; then
  echo "Muduck.app not found in /Applications. Install it first (see README)."
  exit 1
fi

if [ -z "$1" ]; then
  open -a "$APP"
else
  # Resolve absolute path
  if [ -f "$1" ]; then
    ABS_PATH="$(cd "$(dirname "$1")" && pwd)/$(basename "$1")"
  else
    ABS_PATH="$PWD/$1"
  fi
  open -a "$APP" "$ABS_PATH"
fi
